  "logging": {
    "level": "info"
  },
  "database": {
    "path": "./data/database.sqlite",
    "enableAuditHistory": true
  },
  "discord": {
    "intentsPreset": "default",
    "enableMessageContentIntent": true,
    "enableGuildMembersIntent": true,
    "enableGuildPresencesIntent": false
  },
  "security": {
    "confirmationTtlSeconds": 300,
    "rateLimitMaxDestructivePerMinute": 10,
    "rateLimitMaxMessagesPerMinute": 30
  },
  "backup": {
    "exportDir": "./data/backups"
  }
}

